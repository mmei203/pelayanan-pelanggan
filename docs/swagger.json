{
  "openapi": "3.0.3",
  "info": {
    "title": "API Web Perumda",
    "description": "Dokumentasi API Pelayanan Pelanggan dan History",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local server"
    }
  ],
  "paths": {
    "/pelanggan": {
      "get": {
        "summary": "Get all pelanggan / Get pelanggan by status",
        "parameters": [
          {
            "name": "statusPelanggan",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "example": "PENDING"
            },
            "description": "Filter pelanggan berdasarkan status"
          }
        ],
        "responses": {
          "200": {
            "description": "Berhasil mendapatkan data pelanggan"
          }
        }
      }
    },
    "/pelanggan/{id}": {
      "get": {
        "summary": "Get detail pelanggan",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "711208b6-1955-425f-8632-e6850b7fac0d"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Berhasil mendapatkan detail pelanggan"
          }
        }
      },
      "put": {
        "summary": "Edit pelanggan",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "582074bc-48be-4a4b-8d8f-e735a69a1a2f"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "statusPelanggan": {
                    "type": "string",
                    "example": "SELESAI"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Berhasil memperbarui data pelanggan"
          }
        }
      }
    },
    "/pelanggan/tambah-pelanggan": {
      "post": {
        "summary": "Tambah pelanggan",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "namaPelanggan": { "type": "string", "example": "pelanggan 5" },
                  "alamat": { "type": "string", "example": "Jl. Cendana II" },
                  "noPdam": { "type": "integer", "example": 1231232 },
                  "keluhan": { "type": "string", "example": "sedot air limbah" },
                  "noTelp": { "type": "integer", "example": 43234234 }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pelanggan berhasil ditambahkan"
          }
        }
      }
    },
    "/history/": {
      "get": {
        "summary": "Get history",
        "responses": {
          "200": {
            "description": "Berhasil mendapatkan data riwayat"
          }
        }
      }
    }
  }
}