generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum StatusPelanggan {
  PENDING
  ON_PROGRESS
  SELESAI
}

enum roleUser {
  CUSTOMER_SERVICE
  OPERATOR
  PENGAWAS
}

model Pelanggan {
  id                  String             @id @default(uuid())
  namaPelanggan       String             @db.VarChar(500)
  alamat              String             @db.Text
  noPdam              String   
  keluhan             String             @db.Text
  noTelp              String   
  statusPelanggan     StatusPelanggan    @default(PENDING)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  finished            DateTime?
  history             History?
}

model User {
  id          String      @id @default(uuid())
  username    String
  email       String
  password    String
  roleUser    roleUser
}

model History {
  id                 String        @id @default(uuid())
  pelangganId        String        @unique
  pelanggan          Pelanggan     @relation(fields: [pelangganId], references: [id], onDelete: Cascade)
  namaPelanggan      String        @db.VarChar(500)
  keluhan            String        @db.Text
  tanggalLaporan     DateTime
  tanggalSelesai     DateTime      @default(now())
  createdAt          DateTime      @default(now())
}