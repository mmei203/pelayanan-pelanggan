generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Pelanggan {
  id              String          @id @default(uuid())
  namaPelanggan   String          @db.VarChar(500)
  alamat          String          @db.Text
  noPdam          String
  keluhan         String          @db.Text
  noTelp          String
  statusPelanggan StatusPelanggan @default(PENDING)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

enum StatusPelanggan {
  PENDING
  ON_PROGRESS
  SELESAI
}
