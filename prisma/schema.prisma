generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model TabelPelanggan {
  idPelanggan   String           @id @default(uuid()) @map("ID_PELANGGAN") @db.VarChar(36)
  noKontakPdam  String?          @map("NO_KONTAK_PDAM") @db.VarChar(50)
  namaPelanggan String           @map("NAMA_PELANGGAN") @db.VarChar(255)
  noHp          String           @map("NO_HP") @db.VarChar(20)
  alamat        String?          @map("ALAMAT") @db.Text
  createdAt     DateTime?        @default(now()) @map("CREATED_AT") @db.Timestamp(0)
  pengaduan     TabelPengaduan[]

  @@index([noKontakPdam], map: "AK_IDENTIFIER_NO_KONTAK_PDAM")
  @@map("TABEL_PELANGGAN")
}

model TabelUser {
  idUser             String           @id @default(uuid()) @map("ID_USER") @db.VarChar(36)
  namaUser           String           @map("NAMA_USER") @db.VarChar(100)
  email              String           @unique(map: "AK_IDENTIFIRE_EMAIL") @map("EMAIL") @db.VarChar(255)
  username           String           @unique(map: "AK_IDENTIFIER_USERNAME") @map("USERNAME") @db.VarChar(255)
  password           String           @map("PASSWORD") @db.VarChar(255)
  role               TABEL_USER_ROLE  @map("ROLE")
  createdAt          DateTime?        @default(now()) @map("CREATED_AT") @db.Timestamp(0)
  pengaduanDitangani TabelPengaduan[] @relation("Menangani")
  pengaduanDiterima  TabelPengaduan[] @relation("Menerima")

  @@map("TABEL_USER")
}

model TabelPengaduan {
  idPengaduan      String                          @id @default(uuid()) @map("ID_PENGADUAN") @db.VarChar(36)
  idPelanggan      String                          @map("ID_PELANGGAN") @db.VarChar(36)
  idUserPenerima   String                          @map("ID_USER") @db.VarChar(36)
  idUserPenanganan String?                         @map("TAB_ID_USER") @db.VarChar(36)
  keluhan          String                          @map("KELUHAN") @db.Text
  status           String                          @map("STATUS") @db.VarChar(20)
  latitude         String?                         @map("LATITUDE") @db.VarChar(50)
  longitude        String?                         @map("LONGITUDE") @db.VarChar(50)
  dokumenLaporan   String?                         @map("DOKUMEN_LAPORAN") @db.VarChar(500)
  fotoKeluhan      String?                         @map("FOTO_KELUHAN") @db.VarChar(255)
  tanggalDiterima  DateTime                        @default(now()) @map("TANGGAL_DITERIMA") @db.DateTime(0)
  tanggalDiproses  DateTime?                       @map("TANGGAL_DIPROSES") @db.DateTime(0)
  tanggalSelesai   DateTime?                       @map("TANGGAL_SELESAI") @db.DateTime(0)
  createdAt        DateTime                        @default(now()) @map("CREATED_AT") @db.Timestamp(0)
  updatedAt        DateTime?                       @updatedAt @map("UPDATED_AT") @db.Timestamp(0)
  saluranKeluhan   TABEL_PENGADUAN_SALURAN_KELUHAN @default(WhatsApp) @map("SALURAN_KELUHAN")

  pelanggan        TabelPelanggan                  @relation(fields: [idPelanggan], references: [idPelanggan], onUpdate: Restrict, map: "FK_MEMILIKI")
  penangani        TabelUser?                      @relation("Menangani", fields: [idUserPenanganan], references: [idUser], onUpdate: Restrict, map: "FK_MENANGANI")
  penerima         TabelUser                       @relation("Menerima", fields: [idUserPenerima], references: [idUser], onUpdate: Restrict, map: "FK_MENERIMA")

  @@index([idPelanggan], map: "FK_MEMILIKI")
  @@index([idUserPenanganan], map: "FK_MENANGANI")
  @@index([idUserPenerima], map: "FK_MENERIMA")
  @@map("TABEL_PENGADUAN")
}

enum TABEL_USER_ROLE {
  Super_Admin @map("Super Admin")
  CS
  Operator
  Pengawas
}

enum TABEL_PENGADUAN_SALURAN_KELUHAN {
  WhatsApp
  Telepon
  Datang_Ketempat @map("Datang Ketempat")
}
